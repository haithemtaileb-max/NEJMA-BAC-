# Copy to .env.local and fill in. Leave the Supabase values empty to run in demo mode.

# Supabase → Project Settings → API (or the output of `npx supabase start` locally)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…) — or the legacy anon key via NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URL of the site, used in confirmation e-mails when the request has no Origin header
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only for `npm run test:db`: any PostgreSQL 15+ server where the tests may create databases
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
